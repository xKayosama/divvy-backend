NODE_ENV=production
PORT=5000
MONGO_URI=
JWT_SECRET=
JWT_EXPIRES_IN=7d
PDFTOPPM_PATH=/usr/bin/pdftoppm

# Email for signup, password reset and email changes (backend only).
# Choose gmail (no domain required) or resend (verified domain required).
EMAIL_PROVIDER=gmail
GMAIL_USER=
# Use a Google App Password, not your normal Gmail password.
GMAIL_APP_PASSWORD=
# Used only when EMAIL_PROVIDER=resend:
RESEND_API_KEY=
PASSWORD_RESET_FROM=

# Enable only after configuring FCM/APNs and testing delivery.
BILL_NOTIFICATIONS_ENABLED=false
# Optional: required if enhanced Expo push security is enabled.
EXPO_ACCESS_TOKEN=
