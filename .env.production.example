NODE_ENV=production
PORT=5000
MONGO_URI=
JWT_SECRET=
JWT_EXPIRES_IN=7d
PDFTOPPM_PATH=/usr/bin/pdftoppm

# Password reset email (Resend API key and verified sender; backend only)
RESEND_API_KEY=
PASSWORD_RESET_FROM=

# Enable only after configuring FCM/APNs and testing delivery.
BILL_NOTIFICATIONS_ENABLED=false
# Optional: required if enhanced Expo push security is enabled.
EXPO_ACCESS_TOKEN=
